---
import { getEntry } from 'astro:content';

const profileEntry = await getEntry('profile', 'main');
const profileData = profileEntry!.data;
const name = profileData.name;
const email = profileData.contact.email;
const twitterHandle = profileData.twitterHandle;
const github = profileData.contact.github;
const twitterUrl = `https://x.com/${twitterHandle}`;
const currentYear = new Date().getFullYear();
---

<footer class="text-sm font-mono text-tertiary pt-8">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <span>© {currentYear} {name}</span>
    <div class="flex items-center gap-4">
      <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">Twitter</a>
      <a href={github} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">GitHub</a>
      <a href={`mailto:${email}`} class="hover:text-foreground transition">{email}</a>
    </div>
  </div>
</footer>
