---
import { getCollection } from "astro:content";
import { markdownToHtml } from "satteri";

const rawExperience = await getCollection("experience");
const projects = rawExperience.sort((a, b) => a.data.order - b.data.order).map(e => ({
  slug: e.id,
  name: e.data.company,
  period: e.data.period,
  role: e.data.role,
  description: markdownToHtml(e.data.description).html,
  url: e.data.url,
}));
---

<section id="selected-work">
  <div class="flex items-center justify-between text-xs font-mono text-tertiary uppercase tracking-wider mb-6">
    <span>Selected Work</span>
  </div>

  <div class="space-y-8">
    {projects.map((project) => (
      <div class="block group">
        <div class="flex items-baseline justify-between gap-4 mb-1">
          <h2 class="text-base font-medium text-foreground">
            <span>{project.name}</span>
            <span class="text-xs text-tertiary font-mono ml-2">/ {project.role}</span>
          </h2>
          <span class="text-xs font-mono text-tertiary shrink-0">{project.period}</span>
        </div>

        <div class="text-sm text-muted-foreground leading-relaxed mb-3 prose prose-zinc dark:prose-invert prose-sm prose-p:my-0 max-w-none transition-colors" set:html={project.description}>
        </div>

        <div class="flex items-center gap-4">
          <a href={`/work/${project.slug}`} class="text-xs font-mono text-tertiary hover:text-foreground transition-colors">Read case study →</a>
          {project.url && (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-tertiary hover:text-foreground transition-colors">Visit live site ↗</a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
