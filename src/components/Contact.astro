---
import { getEntry } from 'astro:content';

const profileEntry = await getEntry('profile', 'main');
const profileData = profileEntry!.data;
const { email } = profileData.contact;
const calLink = profileData.contact.cal || "#";
---

<section id="contact">
  <div class="text-xs font-mono text-tertiary uppercase tracking-wider mb-6">Contact</div>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="space-y-1">
      <div class="text-base font-medium text-foreground">Need something built?</div>
      <div class="text-sm text-muted-foreground">Let's discuss the requirements, technical approach, and what it would take to ship it.</div>
    </div>
    <div class="flex items-center gap-3">
      <a href={`mailto:${email}`} class="px-4 py-2 text-sm font-mono text-muted-foreground hover:text-foreground transition">
        Email Me
      </a>
      <a href={calLink} target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-foreground text-canvas text-sm font-mono font-medium transition hover:opacity-90">
        Book Call ↗
      </a>
    </div>
  </div>
</section>
