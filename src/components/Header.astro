---
import { getEntry } from 'astro:content';

const profileEntry = await getEntry('profile', 'main');
const profileData = profileEntry!.data;
const name = profileData.name;
const github = profileData.contact.github;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isBlog = pathname.startsWith('/blog');
---

<style>
  .mobile-menu {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .mobile-menu .menu-link {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .mobile-menu.is-open .menu-link {
    opacity: 1;
    transform: translateY(0);
  }
  .mobile-menu.is-open .menu-link:nth-child(1) { transition-delay: 0.05s; }
  .mobile-menu.is-open .menu-link:nth-child(2) { transition-delay: 0.1s; }
  .mobile-menu.is-open .menu-link:nth-child(3) { transition-delay: 0.15s; }
  .mobile-menu.is-open .menu-link:nth-child(4) { transition-delay: 0.2s; }
  .mobile-menu.is-open .menu-link:nth-child(5) { transition-delay: 0.25s; }
  .mobile-menu.is-open .menu-link:nth-child(6) { transition-delay: 0.3s; }
</style>

<header class="flex items-center justify-between">
  <a href="/" class="text-lg font-medium tracking-tight text-foreground hover:opacity-80 transition">
    {name}
  </a>

  {/* Desktop nav */}
  <nav class="hidden md:flex items-center gap-5 text-sm font-mono text-muted-foreground" aria-label="Main navigation">
    <a href="/" class:list={["hover:text-foreground transition", isHome && "text-foreground"]}>Work</a>
    <a href="/#capabilities" class="hover:text-foreground transition">Capabilities</a>
    <a href="/blog" class:list={["hover:text-foreground transition", isBlog && "text-foreground"]}>Blog</a>
    <a href={github} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">GitHub</a>
    <a href="/#contact" class="hover:text-foreground transition">Contact</a>
    <button
      id="theme-toggle"
      type="button"
      class="hover:text-foreground transition p-1 -mr-1"
      aria-label="Switch to dark mode"
    >
      <svg class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <svg class="block dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
    </button>
  </nav>

  {/* Mobile controls */}
  <div class="flex items-center gap-2 md:hidden">
    <button
      id="theme-toggle-mobile"
      type="button"
      class="hover:text-foreground transition p-1"
      aria-label="Switch to dark mode"
    >
      <svg class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <svg class="block dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
    </button>
    <button
      id="mobile-menu-btn"
      type="button"
      class="p-1 hover:text-foreground transition"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  {/* Mobile menu */}
  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-0 z-50 bg-canvas md:hidden"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <nav class="flex flex-col items-center justify-center h-full gap-8 text-lg font-mono text-muted-foreground">
      <span class="menu-link text-lg font-medium tracking-tight text-foreground">{name}</span>
      <a href="/" class:list={["menu-link hover:text-foreground transition", isHome && "text-foreground"]}>Work</a>
      <a href="/#capabilities" class="menu-link hover:text-foreground transition">Capabilities</a>
      <a href="/blog" class:list={["menu-link hover:text-foreground transition", isBlog && "text-foreground"]}>Blog</a>
      <a href={github} target="_blank" rel="noopener noreferrer" class="menu-link hover:text-foreground transition">GitHub</a>
      <a href="/#contact" class="menu-link hover:text-foreground transition">Contact</a>
    </nav>
    <button
      id="mobile-menu-close"
      type="button"
      class="absolute top-4 right-4 p-2 hover:text-foreground transition"
      aria-label="Close menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function() {
    function setupThemeToggle(btnId) {
      const btn = document.getElementById(btnId);
      if (!btn) return;
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const next = isDark ? 'light' : 'dark';
        document.documentElement.classList.toggle('dark', next === 'dark');
        localStorage.setItem('theme', next);
      });
    }

    setupThemeToggle('theme-toggle');
    setupThemeToggle('theme-toggle-mobile');

    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('mobile-menu-close');

    function closeMenu() {
      menu.classList.remove('is-open');
      menuBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    if (menuBtn && menu && closeBtn) {
      menuBtn.addEventListener('click', () => {
        menu.classList.add('is-open');
        menuBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      });

      closeBtn.addEventListener('click', closeMenu);

      menu.addEventListener('click', (e) => {
        const target = e.target;
        if (target === menu || target.tagName === 'A') {
          closeMenu();
        }
      });
    }
  })();
</script>
