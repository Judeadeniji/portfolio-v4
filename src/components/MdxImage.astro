---
import { Image } from 'astro:assets';

interface Props {
  src: any;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, width, height, class: className = '' } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  class:list={["w-full h-auto", className]}
  loading="lazy"
/>
