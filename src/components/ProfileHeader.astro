---
import { getEntry } from 'astro:content';

const profileEntry = await getEntry('profile', 'main');
const profileData = profileEntry!.data;

const location = profileData.contact.location;
const bio = profileData.bio;
---

<section class="animate-enter" aria-label="Profile introduction">
  <div class="flex items-center justify-end mb-3">
    <span class="text-xs font-mono text-tertiary">{location}</span>
  </div>

  <h1 class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight leading-snug mb-3">
    I build and ship full-stack web products from architecture to production.
  </h1>
  <p class="text-muted-foreground text-sm sm:text-base leading-relaxed max-w-xl">
    {bio}
  </p>
</section>
