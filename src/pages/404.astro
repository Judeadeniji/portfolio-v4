---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404: Not Found | Oluwaferanmi Adeniji">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6 animate-enter">
    <div class="text-[120px] font-bold leading-none text-foreground/5 select-none">404</div>
    
    <div class="space-y-2">
      <h1 class="text-xl font-semibold text-foreground">Page not found</h1>
      <p class="text-muted-foreground text-sm">The page you're looking for doesn't exist.</p>
    </div>

    <a 
      href="/" 
      class="px-4 py-2 bg-foreground text-canvas text-sm font-mono font-medium transition hover:opacity-90"
    >
      ← Home
    </a>
  </div>

  <Footer />
</Layout>
