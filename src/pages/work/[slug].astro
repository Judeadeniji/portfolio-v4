---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { markdownToHtml } from "satteri";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const experiences = await getCollection("experience");
  return experiences.map((exp) => ({
    params: { slug: exp.id },
    props: { exp },
  }));
}

const { exp } = Astro.props;
const data = exp.data;

const profileEntry = await getEntry('profile', 'main');
const author = profileEntry!.data;

const descriptionHtml = markdownToHtml(data.description).html;
const highlightsHtml = data.highlights ? data.highlights.map(h => markdownToHtml(h).html) : [];

const title = `${data.company} — ${data.role}`;
---

<Layout title={`${title} | ${author.name}`} description={data.description}>
  <div class="animate-enter">
    <div class="flex items-center justify-between mb-8">
      <a href="/#selected-work" class="text-sm font-mono text-muted-foreground hover:text-foreground transition">← Work</a>
      <span class="text-sm font-mono text-tertiary">{data.period}</span>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-semibold text-foreground tracking-tight leading-snug mb-2">
        {data.company}
      </h1>
      <div class="flex items-center gap-3 text-sm font-mono text-tertiary">
        <span>{data.role}</span>
        <span>·</span>
        <span>{data.location}</span>
      </div>
    </header>

    <div class="article-content text-base sm:text-lg mb-14">
      <div set:html={descriptionHtml} />
    </div>

    {highlightsHtml.length > 0 && (
      <section class="mb-14">
        <h2 class="text-xs font-mono text-tertiary uppercase tracking-wider mb-5">What I Built</h2>
        <ul class="space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed">
          {highlightsHtml.map((html) => (
            <li class="flex gap-3">
              <span class="text-tertiary mt-1.5 shrink-0">—</span>
              <div class="prose prose-zinc dark:prose-invert prose-sm prose-p:my-0 max-w-none" set:html={html} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="flex items-center justify-between text-sm font-mono text-tertiary">
      <a href="/#selected-work" class="text-muted-foreground hover:text-foreground transition">← All work</a>
    </div>
  </div>

  <Footer />
</Layout>
