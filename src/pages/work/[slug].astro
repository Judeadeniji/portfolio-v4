---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const experiences = await getCollection("experience");
  const workEntries = await getCollection("work");

  return experiences.map((exp) => {
    const workEntry = workEntries.find((w) => w.id === exp.id);
    return {
      params: { slug: exp.id },
      props: { exp, workEntry: workEntry ?? null },
    };
  });
}

const { exp, workEntry } = Astro.props;
const data = exp.data;

const profileEntry = await getEntry("profile", "main");
const author = profileEntry!.data;

// Render MDX content if available
let Content: any = null;
let headings: any[] = [];
if (workEntry) {
  const rendered = await render(workEntry);
  Content = rendered.Content;
  headings = rendered.headings;
}

const title = `${data.company} — ${data.role}`;
---

<Layout title={`${title} | ${author.name}`} description={data.description}>
  <div class="animate-enter">
    <div class="flex items-center justify-between mb-8">
      <a href="/#selected-work" class="text-sm font-mono text-muted-foreground hover:text-foreground transition">
        ← Work
      </a>
      <span class="text-sm font-mono text-tertiary">{data.period}</span>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-semibold text-foreground tracking-tight leading-snug mb-2">
        {data.company}
      </h1>
      <p class="text-base text-muted-foreground mb-3">{data.description}</p>
      <div class="flex items-center gap-3 text-sm font-mono text-tertiary">
        <span>{data.role}</span>
        <span>·</span>
        <span>{data.location}</span>
      </div>
    </header>

    {/* Images */}
    {data.images && data.images.length > 0 && (
      <section class="mb-14">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {data.images.map((img: string) => (
            <div class="rounded-lg overflow-hidden border border-border bg-muted">
              <img
                src={`/images/${img}`}
                alt={data.company}
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    {/* MDX Content */}
    {Content && (
      <article class="article-content text-base sm:text-lg mb-14">
        <Content />
      </article>
    )}

    {/* Fallback if no MDX: show highlights */}
    {!Content && data.highlights && data.highlights.length > 0 && (
      <section class="mb-14">
        <h2 class="text-xs font-mono text-tertiary uppercase tracking-wider mb-5">Highlights</h2>
        <ul class="space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed">
          {data.highlights.map((highlight: string) => (
            <li class="flex gap-3">
              <span class="text-tertiary mt-1.5 shrink-0">—</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Stack */}
    {data.stack && data.stack.length > 0 && (
      <section class="mb-14">
        <h2 class="text-xs font-mono text-tertiary uppercase tracking-wider mb-5">Stack</h2>
        <div class="flex flex-wrap gap-2">
          {data.stack.map((tech: string) => (
            <span class="px-3 py-1.5 text-xs font-mono text-muted-foreground bg-muted border border-border rounded-md">
              {tech}
            </span>
          ))}
        </div>
      </section>
    )}

    {/* Links */}
    <div class="flex items-center justify-between text-sm font-mono text-tertiary pt-6 border-t border-border">
      <a href="/#selected-work" class="text-muted-foreground hover:text-foreground transition">← All work</a>
      {data.url && (
        <a href={data.url} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition">
          Visit site ↗
        </a>
      )}
    </div>
  </div>

  <Footer />
</Layout>
