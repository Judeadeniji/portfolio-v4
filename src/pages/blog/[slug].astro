---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import avatarImg from "../../assets/avatar.png";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  posts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

  return posts.map((post, index) => {
    return {
      params: { slug: post.id },
      props: { 
        post,
        prevPost: index + 1 < posts.length ? posts[index + 1] : null,
        nextPost: index - 1 >= 0 ? posts[index - 1] : null,
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

const profileEntry = await getEntry('profile', 'main');
const author = profileEntry!.data;

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={`${post.data.title} | ${author.name}`} description={post.data.description} image={`/blog/${post.id}/og.png`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": new Date(post.data.date).toISOString(),
    "author": {
      "@type": "Person",
      "name": author.name,
      "url": Astro.url.origin
    }
  })} />

  <div class="animate-enter">
    <div class="flex items-center justify-between mb-8">
      <a href="/blog" class="text-sm font-mono text-muted-foreground hover:text-foreground transition">
        ← Back
      </a>
      <div class="text-sm font-mono text-tertiary">{formatDate(new Date(post.data.date))}</div>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-semibold text-foreground tracking-tight leading-snug mb-3">{post.data.title}</h1>
      <div class="flex items-center gap-3 text-sm font-mono text-tertiary">
        <span>{readingTime} min read</span>
        <span>·</span>
        <span>{post.data.category}</span>
      </div>
    </header>

    {/* Table of Contents */}
    {headings.length > 0 && (
      <details class="group text-sm text-muted-foreground mb-10">
        <summary class="font-mono text-xs text-tertiary hover:text-foreground cursor-pointer transition select-none inline-flex items-center gap-1">
          <span>Table of Contents</span>
          <span class="group-open:rotate-180 transition-transform text-[9px]">▾</span>
        </summary>
        <div class="mt-2 pl-3 space-y-1.5">
          {headings.filter((h) => h.depth <= 3).map((heading) => (
            <a href={`#${heading.slug}`} class={`block hover:text-foreground transition-colors ${heading.depth === 3 ? 'pl-4' : ''}`}>
              <span class="opacity-50 mr-2">#</span>
              <span>{heading.text}</span>
            </a>
          ))}
        </div>
      </details>
    )}

    {/* Article Content */}
    <article class="article-content text-base sm:text-lg">
      <Content />
    </article>

    {/* Author */}
    <div class="mt-14">
      <div class="flex items-start gap-4">
        <Image src={avatarImg} alt={author.name} class="size-11 shrink-0 object-cover" width={44} height={44} loading="lazy" />
        <div>
          <div class="text-base font-medium text-foreground mb-0.5">{author.name}</div>
          <div class="text-sm text-tertiary mb-2">Product Engineer</div>
          <div class="flex flex-wrap gap-3 text-sm text-muted-foreground">
            <a href={`https://x.com/${author.twitterHandle}`} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">Twitter</a>
            <a href={author.contact.github} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">GitHub</a>
            <a href={author.contact.cal} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">Book a Call</a>
          </div>
        </div>
      </div>
    </div>

    {/* Navigation */}
    <div class="mt-10 pt-6 flex items-center justify-between text-sm font-mono text-tertiary">
      <a href="/blog" class="text-muted-foreground hover:text-foreground transition">← Blog</a>
      {nextPost && (
        <a href={`/blog/${nextPost.id}`} class="hover:text-foreground transition">{nextPost.data.title} →</a>
      )}
    </div>
  </div>

  <Footer />
</Layout>
