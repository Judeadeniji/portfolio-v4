---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from "astro:content";
import Footer from '../../../components/Footer.astro';

const posts = await getCollection("blog");
const categories = Array.from(new Set(posts.map(p => p.data.category).filter(Boolean)));

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Categories | Blog",
  "description": "Browse all blog post categories.",
  "url": Astro.url.href,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": categories.map((cat, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": new URL(`/blog/categories/${(cat).toLowerCase()}`, Astro.url.origin).href,
      "name": cat
    }))
  }
};
---

<Layout title="Categories | Blog" description="Browse all blog post categories.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  
  <div class="animate-enter">
    <div class="mb-8">
      <div class="flex items-center justify-between mb-2">
        <h1 class="text-2xl font-semibold text-foreground tracking-tight">Categories</h1>
        <a href="/blog" class="text-sm font-mono text-muted-foreground hover:text-foreground transition">← Back</a>
      </div>
      <p class="text-sm text-muted-foreground">Browse all blog post categories.</p>
    </div>

    <div class="space-y-4">
      {categories.map(cat => (
        <a href={`/blog/categories/${cat.toLowerCase()}`} class="block">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-base font-medium text-foreground">{cat}</h2>
            <span class="text-xs font-mono text-tertiary shrink-0">{posts.filter(p => p.data.category === cat).length} posts</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <Footer />
</Layout>
