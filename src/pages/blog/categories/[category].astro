---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from "astro:content";
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const categories = Array.from(new Set(posts.map(p => p.data.category).filter(Boolean)));
  return categories.map(cat => ({
    params: { category: cat.toLowerCase() },
    props: { cat, posts: posts.filter(p => p.data.category === cat) }
  }));
}

const { cat, posts } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${cat} Posts | Blog`,
  "description": `Explore all blog posts in the ${cat} category.`,
  "url": Astro.url.href,
  "about": {
    "@type": "Thing",
    "name": cat
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": posts.map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": new URL(`/blog/${post.id}`, Astro.url.origin).href,
      "name": post.data.title
    }))
  }
};
---

<Layout title={`${cat} Posts | Blog`} description={`Explore all blog posts in the ${cat} category.`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  
  <div class="animate-enter">
    <div class="mb-8">
      <div class="flex items-center justify-between mb-2">
        <h1 class="text-2xl font-semibold text-foreground tracking-tight">{cat}</h1>
        <a href="/blog" class="text-sm font-mono text-muted-foreground hover:text-foreground transition">← Back</a>
      </div>
      <p class="text-sm text-muted-foreground">{posts.length} posts in this category.</p>
    </div>

    <div class="space-y-6">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="block">
          <div class="flex items-baseline justify-between gap-4 mb-1">
            <h2 class="text-base font-medium text-foreground">{post.data.title}</h2>
            <span class="text-xs font-mono text-tertiary shrink-0">{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed mb-1">{post.data.description}</p>
        </a>
      ))}
    </div>
  </div>

  <Footer />
</Layout>
