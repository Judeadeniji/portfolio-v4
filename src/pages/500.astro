---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

interface Props {
    error?: unknown;
}
const { error } = Astro.props;
---

<Layout title="500: Server Error | Oluwaferanmi Adeniji">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6 animate-enter">
    <div class="text-[120px] font-bold leading-none text-foreground/5 select-none">500</div>
    
    <div class="space-y-2">
      <h1 class="text-xl font-semibold text-foreground">Server Error</h1>
      <p class="text-muted-foreground text-sm">Something went wrong. Please try again later.</p>
    </div>

    <a 
      href="/" 
      class="px-4 py-2 bg-foreground text-canvas text-sm font-mono font-medium transition hover:opacity-90"
    >
      ← Home
    </a>
  </div>

  <Footer />
</Layout>
