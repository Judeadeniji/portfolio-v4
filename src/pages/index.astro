---
import Layout from "../layouts/Layout.astro";
import ProfileHeader from "../components/ProfileHeader.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Capabilities from "../components/Capabilities.astro";
import OpenSource from "../components/OpenSource.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import BlogHighlight from "../components/BlogHighlight.astro";
import { getEntry, getCollection } from "astro:content";

const profileEntry = await getEntry("profile", "main");
const name = profileEntry!.data.name;
const description = profileEntry!.data.bio.split('\n')[0].replace(/<[^>]*>?/gm, '').replace(/\*\*/g, '');

const rawProjects = await getCollection("projects");
const schemaProjects = rawProjects.map(p => ({
  "@type": "SoftwareApplication",
  "name": p.data.name,
  "description": p.data.description,
  "url": p.data.live_url || p.data.repo || Astro.url.origin
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": name,
    "jobTitle": "Product Engineer",
    "url": Astro.url.origin,
    "image": new URL("/og-image.png", Astro.url.origin).href,
    "sameAs": [
        "https://github.com/Judeadeniji",
        "https://www.linkedin.com/in/feranmi-adeniji",
        "https://x.com/iam_feranmi_"
    ],
    "hasPart": schemaProjects
  }
};
---

<Layout title={`${name} | Portfolio`} description={description} schema={schema}>
  <ProfileHeader />
  <About />
  <Capabilities />
  <SelectedWork />
  <BlogHighlight />
  <OpenSource />
  <Contact />
  <Footer />
</Layout>
